# ── Sanity CMS (the client dashboard) ────────────────────────────────────────
# Copy this file to `.env.local` and fill in your Project ID.
# Until these are set, the site runs on its built-in fallback content.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Optional — pin the API version (defaults to 2024-10-01):
# NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# ── Seeding only (do NOT commit a real value) ────────────────────────────────
# A write token (Sanity → API → Tokens → "Editor") used once by scripts/seed.ts
# to preload all content. Delete/rotate it after seeding.
# SANITY_WRITE_TOKEN=

